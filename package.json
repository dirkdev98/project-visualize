{
  "name": "project-visualize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build-resources.mjs && maligator run --",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:visual",
    "check:html": "playwright test tests/visual/components.spec.mjs tests/visual/interactions.spec.mjs tests/visual/partial.spec.mjs",
    "check:html:update": "playwright test tests/visual/components.spec.mjs tests/visual/interactions.spec.mjs tests/visual/partial.spec.mjs --update-snapshots",
    "setup:browser": "PLAYWRIGHT_SKIP_BROWSER_GC=1 playwright install chromium",
    "check:viewer": "node scripts/check-presentation.mjs",
    "check:readback": "node scripts/check-native.mjs readback",
    "check:bindings": "node scripts/check-native.mjs bindings",
    "check:images": "node scripts/check-native.mjs images",
    "check:plots": "node scripts/check-native.mjs plots",
    "check:selection": "node scripts/check-native.mjs selection",
    "check:inputs": "node scripts/check-inputs.mjs",
    "check:navigation": "node scripts/check-native.mjs navigation",
    "check:menu": "node scripts/check-menu.mjs",
    "check:linux-package": "node scripts/check-linux-package.mjs",
    "check:visual": "playwright test",
    "check:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@maligator/cli": "0.1.0-alpha.34",
    "@playwright/test": "1.65.0",
    "@types/node": "25.0.3",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "wawoff2": "2.0.1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "entities": "9.0.0",
    "marked": "18.1.3",
    "pdf-lib": "1.17.1"
  }
}
