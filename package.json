{
  "name": "project-visualize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build-resources.mjs && maligator run --",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:viewer": "node scripts/check-presentation.mjs",
    "check:readback": "node scripts/check-native.mjs readback",
    "check:bindings": "node scripts/check-native.mjs bindings",
    "check:images": "node scripts/check-native.mjs images",
    "check:plots": "node scripts/check-native.mjs plots",
    "check:selection": "node scripts/check-native.mjs selection",
    "check:inputs": "node scripts/check-inputs.mjs",
    "check:navigation": "node scripts/check-native.mjs navigation",
    "check:menu": "node scripts/check-menu.mjs",
    "check:linux-package": "node scripts/check-linux-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@maligator/cli": "0.1.0-alpha.33",
    "@types/node": "25.0.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "entities": "9.0.0",
    "marked": "18.1.3",
    "pdf-lib": "1.17.1"
  }
}
