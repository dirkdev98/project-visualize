{
  "schemaVersion": 1,
  "title": "Patterns across the field",
  "subtitle": "Completeness by station and day, with missing evidence kept visible",
  "category": "Dataset study",
  "context": {
    "source": "Fictional demonstration data",
    "question": "Which station and day combinations need attention?",
    "method": "Numeric observations are averaged within each station and day. Filtering preserves the original axes and color scale."
  },
